{
  "name": "openclaw-vkteams-plugin",
  "version": "26.1.2",
  "description": "VK Teams Bot API channel plugin for OpenClaw",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "git config core.hooksPath .githooks || true",
    "check": "tsc --noEmit",
    "test": "vitest run src/*.test.ts",
    "check:commit-message": "node scripts/validate-commit-msg.mjs",
    "check:version": "node scripts/validate-version.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": { "zod": "4.6.7" },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@types/node": "^24.0.0",
    "openclaw": "2026.11.7",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.22"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/potapovjakov/openclaw-vkteams-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/potapovjakov/openclaw-vkteams-plugin/issues"
  },
  "homepage": "https://github.com/potapovjakov/openclaw-vkteams-plugin#readme",
  "keywords": [
    "openclaw",
    "plugin",
    "channel",
    "vk"
  ],
  "license": "MIT",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24"
    },
    "build": {
      "openclawVersion": "2026.11.7"
    },
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "vkteams",
      "label": "VK Teams",
      "selectionLabel": "VK Teams (Bot API)",
      "detailLabel": "VK Teams Bot API",
      "docsPath": "/plugins/community",
      "docsLabel": "Community plugins",
      "blurb": "VK Teams bot via long polling for direct-message routing.",
      "order": 85,
      "quickstartAllowFrom": true
    },
    "install": {
      "npmSpec": "openclaw-vkteams-plugin",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.3.22"
    },
    "release": {
      "publishToNpm": true
    }
  }
}
